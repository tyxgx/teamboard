datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin-arm64"]
}

model User {
  id               String            @id @default(uuid())
  name             String
  email            String            @unique
  image            String? // Optional profile picture
  googleId         String? // Optional Google ID
  role             String            @default("MEMBER")
  comments         Comment[]
  boardMemberships BoardMembership[]
  createdBoards    Board[]           @relation("UserCreatedBoards")
  lastCommentBoards Board[]          @relation("BoardLastCommentSender")
  reactions        Reaction[]
  attachments      Attachment[]
}

model Board {
  id            String            @id @default(uuid())
  name          String
  code          String            @unique // Unique invite code
  createdAt     DateTime          @default(now())
  lastActivity  DateTime          @default(now())
  anonymousEnabled Boolean       @default(false)
  lastCommentAt        DateTime?
  lastCommentPreview   String?
  lastCommentVisibility Visibility?
  lastCommentAnonymous  Boolean   @default(false)
  lastCommentSenderId   String?
  lastCommentSenderName String?
  lastCommentSender     User?     @relation("BoardLastCommentSender", fields: [lastCommentSenderId], references: [id])
  createdBy     String
  createdByUser User              @relation("UserCreatedBoards", fields: [createdBy], references: [id])
  comments      Comment[]
  members       BoardMembership[]
  attachments   Attachment[]

  @@index([lastActivity], map: "idx_board_last_activity")
  @@index([lastCommentAt], map: "idx_board_last_comment_at")
}

model BoardMembership {
  id      String @id @default(uuid())
  userId  String
  boardId String
  role    Role   @default(MEMBER)
  pinned  Boolean @default(false)
  status  MembershipStatus @default(ACTIVE)
  leftAt  DateTime?
  // Last time this member had the board open and scrolled to the latest message (read receipts)
  lastReadAt DateTime?

  user  User  @relation(fields: [userId], references: [id])
  board Board @relation(fields: [boardId], references: [id])

  @@unique([userId, boardId])
  @@index([userId, status], map: "idx_boardmembership_user_status")
  @@index([userId], map: "idx_boardmembership_user")
}

model Comment {
  id          String     @id @default(uuid())
  content     String
  visibility  Visibility
  createdById String
  boardId     String
  anonymous   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  // Optional client-generated UUID for idempotency and optimistic sends
  clientId    String?
  // Reply-to: points at the message being answered (same board, checked in the controller)
  parentId    String?
  // Set when the author edits the message after sending
  editedAt    DateTime?

  createdBy User  @relation(fields: [createdById], references: [id])
  board     Board @relation(fields: [boardId], references: [id])
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies   Comment[] @relation("CommentReplies")
  reactions Reaction[]
  attachment Attachment?

  @@index([boardId, createdAt], map: "idx_comment_board_created")
  @@index([boardId, createdAt, id], map: "idx_comment_board_created_id")
  @@unique([boardId, clientId], map: "uq_comment_board_client_id")
  @@index([createdById], map: "idx_comment_created_by")
  @@index([parentId], map: "idx_comment_parent")
  @@index([boardId, visibility, createdAt], map: "idx_comment_board_visibility_created")
}

model Reaction {
  id        String   @id @default(uuid())
  commentId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([commentId, userId, emoji], map: "uq_reaction_comment_user_emoji")
  @@index([commentId], map: "idx_reaction_comment")
}

// Image attachments are stored in Postgres (bytea, capped at 2MB) so the app needs no separate
// object store. Move to S3 if usage grows: only the read/write in attachment.controller.ts changes.
model Attachment {
  id         String   @id @default(uuid())
  boardId    String
  uploaderId String
  mime       String
  size       Int
  data       Bytes
  createdAt  DateTime @default(now())
  // Set when the message that carries the image is created; null while it is only uploaded
  commentId  String?  @unique

  board    Board    @relation(fields: [boardId], references: [id])
  uploader User     @relation(fields: [uploaderId], references: [id])
  comment  Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([boardId], map: "idx_attachment_board")
}

enum Role {
  ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  LEFT
}

enum Visibility {
  ADMIN_ONLY
  EVERYONE
}
